# Copy this file to secrets.toml and replace the placeholders.
# secrets.toml is ignored by Git; never commit your real database password.
EXPENSE_DB_HOST = "localhost"
EXPENSE_DB_PORT = "3306"
EXPENSE_DB_USER = "expense_app"
EXPENSE_DB_PASSWORD = "replace-with-your-local-password"
EXPENSE_DB_NAME = "expense_tracker"
EXPENSE_DB_CONNECT_TIMEOUT = "5"
